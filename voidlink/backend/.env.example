# VoidLink Backend Configuration
# Copy this to .env and fill in your values

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Admin credentials (change these!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=voidlink-secure-password-2024

# Ollama
OLLAMA_BASE_URL=http://localhost:11434

# Database
DATABASE_URL=sqlite+aiosqlite:///./voidlink.db

# File uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# CORS - comma separated origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,exp://localhost:8081

# Tailscale / Remote access
TAILSCALE_HOSTNAME=

# Push notifications (optional - use Expo push service)
EXPO_PUSH_TOKEN=

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# System monitoring interval (seconds)
MONITOR_INTERVAL=5
